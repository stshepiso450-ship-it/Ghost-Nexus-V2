export default function MentorEAs() {
  const [eas, setEas] = useState([]);
  const [quantities, setQuantities] = useState({});
  const [loading, setLoading] = useState(true);
  const [workingId, setWorkingId] = useState("");
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [generated, setGenerated] = useState(null);

  const loadEAs = useCallback(async () => {
    setLoading(true);
    setError("");

    try {
      let payload;

      try {
        payload = await apiRequest("/api/mentor/eas");
      } catch (firstError) {
        const dashboard = await apiRequest("/api/mentor/dashboard");
        payload = dashboard?.eas
          ? dashboard
          : { eas: dashboard?.data?.eas || [] };

        if (!getArray(payload).length && firstError) {
          throw firstError;
        }
      }

      const list = getArray(payload);

      setEas(list);
      setQuantities((old) => {
        const next = { ...old };
        list.forEach((ea) => {
          const id = ea.ea_id || ea.id;
          if (id && next[id] == null) next[id] = 1;
        });
        return next;
      });
    } catch (err) {
      setError(
        `${err.message}. Check that you are signed in to the Mentor Portal and that the backend is running.`
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadEAs();
  }, [loadEAs]);

  async function generateLicenses(ea) {
    const eaId = ea.ea_id;
    if (!eaId) {
      setError("This EA response has no EA ID. Ask Admin to assign a valid EA record.");
      return;
    }

    const count = Number(quantities[eaId] || 1);
    if (!Number.isInteger(count) || count < 1 || count > 500) {
      setError("Choose a quantity between 1 and 500.");
      return;
    }

    setWorkingId(eaId);
    setError("");
    setNotice("");
    setGenerated(null);

    try {
      const result = await apiRequest(
        `/api/mentor/eas/${encodeURIComponent(eaId)}/licenses/generate`,
        {
          method: "POST",
          body: JSON.stringify({ count }),
        }
      );

      const returned = getArray(result, [
        "licenses",
        "keys",
        "generated_keys",
        "items",
        "data",
      ]);

      const keys = returned
        .map((item) =>
          typeof item === "string"
            ? item
            : item?.license_key || item?.key || item?.licenseKey
        )
        .filter(Boolean);

      setGenerated({
        eaId,
        eaName: ea.ea_name || ea.name || eaId,
        keys,
      });

      setNotice(
        result.message ||
          (keys.length
            ? `Generated ${keys.length} licence key(s).`
            : "Generation request succeeded. Check the Licences page for saved keys.")
      );

      await loadEAs();
    } catch (err) {
      setError(err.message);
    } finally {
      setWorkingId("");
    }
  }

  return (
    <section className="gn-eas-page">
      <style>{styles}</style>

      <header className="gn-eas-head">
        <div>
          <div className="gn-eas-kicker">GHOST NEXUS / MENTOR WORKSPACE</div>
          <h1 className="gn-eas-title">My Expert Advisors</h1>
          <p className="gn-eas-subtitle">
            EAs assigned by Admin appear here automatically. Select an EA to generate client licence keys.
          </p>
        </div>
        <button
          className="gn-eas-refresh"
          type="button"
          onClick={loadEAs}
          disabled={loading}
        >
          {loading ? "Syncing..." : "↻ Sync EAs"}
        </button>
      </header>

      {error && <div className="gn-eas-msg" role="alert">{error}</div>}
      {notice && <div className="gn-eas-msg" role="status">{notice}</div>}

      {loading ? (
        <div className="gn-eas-empty">Syncing assigned EAs from Ghost Nexus...</div>
      ) : eas.length === 0 ? (
        <div className="gn-eas-empty">
          <strong>No EAs assigned yet</strong>
          <br />
          When Admin releases an EA to your Mentor ID, it will appear here.
          <br />
          Use <strong>Sync EAs</strong> to refresh the list.
        </div>
      ) : (
        <div className="gn-eas-grid">
          {eas.map((ea, index) => {
            const eaId = ea.ea_id || ea.id || `ea-${index}`;
            const eaName = ea.ea_name || ea.name || ea.product_name || "Ghost Nexus EA";
            const status = String(ea.status || "ASSIGNED").toUpperCase();
            const disabled =
              workingId === eaId ||
              (status !== "ACTIVE" && ea.admin_approved !== true) ||
              !ea.ea_id;

            return (
              <article className="gn-ea-card" key={eaId}>
                <div className="gn-ea-row">
                  <div style={{ minWidth: 0 }}>
                    <h2 className="gn-ea-name">{eaName}</h2>
                    <div className="gn-ea-id">{ea.ea_id || "EA ID not supplied"}</div>
                  </div>
                  <span className="gn-ea-status">{status}</span>
                </div>

                <div className="gn-ea-meta">
                  <div>
                    <span>Symbol</span>
                    <strong>{ea.symbol || "Not specified"}</strong>
                  </div>
                  <div>
                    <span>Platform</span>
                    <strong>{ea.platform || "MT5"}</strong>
                  </div>
                  <div>
                    <span>Version</span>
                    <strong>{ea.script_version || ea.version || "1.0.0"}</strong>
                  </div>
                  <div>
                    <span>Licence limit</span>
                    <strong>{ea.max_licenses ?? 500}</strong>
                  </div>
                </div>

                <label className="gn-eas-label" htmlFor={`gn-qty-${eaId}`}>
                  Number of licence keys to generate
                </label>
                <input
                  className="gn-eas-count"
                  id={`gn-qty-${eaId}`}
                  type="number"
                  min="1"
                  max="500"
                  step="1"
                  value={quantities[ea.ea_id] ?? 1}
                  onChange={(event) =>
                    setQuantities((old) => ({
                      ...old,
                      [ea.ea_id]: event.target.value,
                    }))
                  }
                />

                <button
                  type="button"
                  className="gn-eas-generate"
                  disabled={disabled}
                  onClick={() => generateLicenses(ea)}
                >
                  {workingId === eaId
                    ? "Generating..."
                    : !ea.ea_id
                      ? "EA ID missing"
                      : disabled
                        ? "Waiting for Admin approval"
                        : "Generate Licence Keys"}
                </button>

                {generated?.eaId === ea.ea_id && (
                  <div className="gn-eas-keys">
                    <h4>Newly returned keys — {generated.eaName}</h4>
                    {generated.keys.length ? (
                      generated.keys.map((key) => (
                        <code className="gn-eas-key" key={key}>{key}</code>
                      ))
                    ) : (
                      <span className="gn-ea-id">
                        No keys were returned in this response. Check the Licences page to confirm which keys were saved.
                      </span>
                    )}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      )}
    </section>
  );
}
